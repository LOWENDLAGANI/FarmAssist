{
  "name": "farmassist-functions",
  "description": "Firebase Cloud Functions for FarmAssist push notifications",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
