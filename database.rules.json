{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null",
        "notifications": {
          "$notifId": {
            ".validate": "newData.hasChildren(['type', 'title', 'body', 'deviceId', 'createdAt', 'read'])"
          }
        }
      }
    },
    "rover_registry": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "broadcasts": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'tsYo3zKfr8SSowOE23lPQe8Kb0v2'"
    }
  }
}